# Shared local development defaults for the v2 migration.

# Monolith API
API_PORT=4000
DATABASE_URL=postgresql://fragmentaudio:fragmentaudio@localhost:5432/fragmentaudio
DATABASE_POOL_SIZE=10

# Python alignment worker kept as a separate runtime for now.
STABLE_TS_URL=http://localhost:5000/stable-ts

# LLM provider. The API client is OpenAI-compatible and can point to OpenRouter.
LLM_API_KEY=
LLM_API_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemini-2.0-flash-001
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4000
LLM_HTTP_REFERER=
LLM_X_TITLE=FragmentAudio

# Legacy services kept temporarily during migration.
VIDEO_DB_URL=http://localhost:3001/api
LLM_SERVICE_URL=http://localhost:3002/api/llm
ORCHESTRATION_PORT=4001
