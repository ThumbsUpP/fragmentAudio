{
  "name": "stable-ts",
  "version": "1.0.0",
  "scripts": {
    "venv": "python3 -m venv venv",
    "build": "echo 'No build step for Python app'",
    "lint": "venv/bin/python -m py_compile app.py align.py models.py",
    "test": "venv/bin/python -m pytest",
    "start": "bash -c 'set -a; [ ! -f .env ] || source .env; set +a; venv/bin/python app.py'",
    "installPython": "venv/bin/python -m pip install -r requirements.txt",
    "dev": "bash -c 'set -a; [ ! -f .env ] || source .env; set +a; venv/bin/python app.py'"
  }
}
